{
  "manifest_version": 3,
  "name": "Flynn Notes",
  "version": "2.2.0",
  "description": "A modern notepad that lives in your browser's right-side panel. Fast writing, folder saving, your fonts, your shortcuts.",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "contextMenus", "activeTab"],
  "action": {
    "default_title": "Open Flynn Notes",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "commands": {
    "open-side-panel": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open Flynn Notes side panel"
    },
    "new-note": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Open Flynn Notes and start a new note"
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
